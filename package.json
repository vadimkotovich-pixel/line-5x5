{
  "name": "line-5x5",
  "version": "1.0.0",
  "private": true,
  "description": "Мини-лэндинг с игрой «Линия 5×5»: три в ряд зачеркиваются и приносят очки, клетки блокируются навсегда, побеждает тот, у кого очков больше. Игра против компьютера.",
  "license": "MIT",
  "homepage": "https://vadimkotovich-pixel.github.io/line-5x5/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vadimkotovich-pixel/line-5x5.git"
  },
  "type": "commonjs",
  "scripts": {
    "test": "node --test --test-isolation=none tests/rules.test.js tests/ai.test.js tests/ui-contract.test.js tests/dom.test.js",
    "test:logic": "node --test --test-isolation=none tests/rules.test.js tests/ai.test.js",
    "test:ui": "node --test --test-isolation=none tests/ui-contract.test.js tests/dom.test.js",
    "check": "node --check assets/js/rules.js && node --check assets/js/ai.js && node --check assets/js/ui.js",
    "stats": "node tools/selfplay-stats.cjs",
    "visual": "node tools/visual-check.cjs",
    "encoding": "node tools/encoding-check.cjs",
    "live": "node tools/check-live.cjs"
  },
  "devDependencies": {
    "jsdom": "^30.1.2"
  }
}
